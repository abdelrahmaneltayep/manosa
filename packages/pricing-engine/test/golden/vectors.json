      "context": {
        "customer": "wholesale",
        "product": "beans-on-sale",
        "quantity": 100
      },
      "expect": {
        "finalPrice": "10.00",
        "appliedRules": [],
        "skipped": {
          "tiers-10-50-not-sale": "target_excluded"
        }
      }
    },
    {
      "name": "scheduled-rule-before-it-starts",
