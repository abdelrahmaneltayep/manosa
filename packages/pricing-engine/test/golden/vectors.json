  "cases": [
    {
      "name": "no-rules-returns-the-shelf-price",
      "spec": "Baseline",
      "why": "With nothing configured the engine must not invent a discount.",
      "rules": [],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "10.00",
        "appliedRules": []
      }
    },
    {
      "name": "guest-sees-the-shelf-price",
      "spec": "\u00a710 price display \u2014 guests see retail, never a wholesale price",
      "why": "A tag-gated rule must not leak to a logged-out visitor.",
      "rules": ["guests-login-to-see"],
      "context": {
        "customer": null,
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "10.00",
        "appliedRules": [],
        "skipped": {
          "guests-login-to-see": "audience_mismatch"
        }
      }
    },
    {
      "name": "retail-customer-without-the-tag-sees-the-shelf-price",
      "spec": "\u00a73 audience \u2014 customer tags",
      "why": "Being logged in is not the same as being approved.",
      "rules": ["storewide-35"],
      "context": {
        "customer": "retail",
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "10.00",
        "appliedRules": [],
        "skipped": {
          "storewide-35": "audience_mismatch"
        }
      }
    },
    {
      "name": "demo-persona-1-35-percent-storewide",
      "spec": "\u00a711 demo store \u2014 Customer 1, discounted pricing",
      "why": "The simplest wholesale case, and the one on the demo store.",
      "rules": ["storewide-35"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "6.50",
        "appliedRules": ["storewide-35"]
      }
    },
    {
      "name": "demo-persona-2-individual-variant-price",
      "spec": "\u00a711 demo store \u2014 Customer 2, individual variant pricing",
      "why": "A contract price on one variant, not a percentage.",
      "rules": ["variant-contract-price"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 3
      },
      "expect": {
        "finalPrice": "8.00",
        "appliedRules": ["variant-contract-price"]
      }
    },
    {
      "name": "variant-price-does-not-touch-other-variants",
      "spec": "\u00a72 targeting \u2014 individual variants",
      "why": "Targeting a variant must not price the whole catalogue.",
      "rules": ["variant-contract-price"],
      "context": {
        "customer": "wholesale",
        "product": "grinder",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "120.00",
        "appliedRules": [],
        "skipped": {
          "variant-contract-price": "target_mismatch"
        }
      }
    },
    {
      "name": "demo-persona-3-tiers-below-first-break",
      "spec": "\u00a710 product page \u2014 Buy 5 \u2192 5%, Buy 20 \u2192 12%",
      "why": "Under the first break there is no discount, and the next break is offered.",
      "rules": ["tiers-5-20"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "10.00",
        "appliedRules": [],
        "nextTier": {
          "quantity": 5,
          "unitPrice": "9.50"
        },
        "skipped": {
          "tiers-5-20": "no_matching_tier"
        }
      }
    },
    {
      "name": "demo-persona-3-tiers-at-first-break",
      "spec": "\u00a710 product page \u2014 Buy 5 \u2192 5%",
      "why": "The break applies at exactly the minimum quantity, not one above it.",
      "rules": ["tiers-5-20"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 5
      },
      "expect": {
        "finalPrice": "9.50",
        "appliedRules": ["tiers-5-20"],
        "nextTier": {
          "quantity": 20,
          "unitPrice": "8.80"
        }
      }
    },
    {
      "name": "demo-persona-3-tiers-just-under-second-break",
      "spec": "\u00a76 tier-aware upsell \u2014 \"add 1 more unit to unlock the 12% tier\"",
      "why": "This is the number the Buyer Agent quotes; it must come from here.",
      "rules": ["tiers-5-20"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 19
      },
      "expect": {
        "finalPrice": "9.50",
        "appliedRules": ["tiers-5-20"],
        "nextTier": {
          "quantity": 20,
          "unitPrice": "8.80"
        }
      }
    },
    {
      "name": "demo-persona-3-tiers-at-second-break",
      "spec": "\u00a710 product page \u2014 Buy 20 \u2192 12%",
      "why": "The top tier applies and there is no further tier to upsell.",
      "rules": ["tiers-5-20"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 20
      },
      "expect": {
        "finalPrice": "8.80",
        "appliedRules": ["tiers-5-20"],
        "nextTier": null
      }
    },
    {
      "name": "rule-from-a-sentence-at-100-units",
      "spec": "\u00a72 rule-from-a-sentence; \u00a76 \"what's my price for SKU-450 at 100 units?\"",
