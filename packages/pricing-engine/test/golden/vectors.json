    {
      "name": "percentages-round-to-the-nearest-cent",
      "spec": "\u00a78 multi-currency rounding",
      "why": "10.00 less 33.33% is 6.667. Half-up gives 6.67, and it must be the same every run.",
      "rules": ["rounding-third-off"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "6.67",
        "appliedRules": ["rounding-third-off"]
      }
    },
    {
      "name": "rounding-happens-once-at-the-end-not-per-rule",
      "spec": "\u00a78 multi-currency rounding",
      "why": "120.00 less 33.33% is 80.004, which must land on 80.00 and not on 80.01. One rule cannot tell per-step rounding from once-at-the-end \u2014 that is the vector below this one.",
      "rules": ["rounding-third-off"],
      "context": {
        "customer": "wholesale",
        "product": "grinder",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "80.00",
        "appliedRules": ["rounding-third-off"]
      }
    },
    {
      "name": "rounding-happens-once-across-two-stacked-rules",
      "spec": "\u00a78 multi-currency rounding",
      "why": "The single-rule vector cannot tell the two apart: with one rule, rounding per step and rounding at the end are the same arithmetic. Two 33.33% rules on $10.00 are 10.00 \u00d7 0.6667 \u00d7 0.6667 = 4.4449 \u2192 $4.44. Rounding each step gives 6.67 then 4.45 \u2014 a cent the buyer did not earn.",
      "rules": ["stacked-third-off-a", "stacked-third-off-b"],
      "context": {
        "customer": "wholesale",
        "product": "beans",
        "quantity": 1
      },
      "expect": {
        "finalPrice": "4.44",
        "appliedRules": ["stacked-third-off-a", "stacked-third-off-b"]
      }
    },
