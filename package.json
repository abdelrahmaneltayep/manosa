{
  "name": "mannon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "dev:remix": "remix vite:dev",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts",
    "shopify": "shopify",
    "jobs:run": "curl -fsS -X POST -H \"Authorization: Bearer $JOBS_RUNNER_TOKEN\" \"${APP_URL:-http://localhost:3000}/internal/jobs/run\"",
    "qa:capture": "QA_CAPTURE=1 vitest run tests/unit/plans-page-states.test.tsx tests/unit/pricing-pages-states.test.tsx tests/unit/customers-pages-states.test.tsx tests/unit/forms-pages-states.test.tsx tests/unit/applications-page-states.test.tsx tests/unit/orders-pages-states.test.tsx tests/unit/quote-pages-states.test.tsx tests/unit/describe-page-states.test.tsx tests/unit/segments-page-states.test.tsx tests/unit/home-page-states.test.tsx tests/unit/po-page-states.test.tsx tests/unit/setup-pages-states.test.tsx && playwright test tests/e2e/qa-states.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^6.19.3",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@shopify/shopify-app-remix": "^5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "i18next": "^26.4.2",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@remix-run/dev": "^2.17.5",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "^1.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-check": "^4.9.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
