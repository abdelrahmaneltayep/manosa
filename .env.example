# --- Shopify app credentials (Partners dashboard) -------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_products,read_customers,write_customers,read_orders,write_draft_orders,write_discounts

# Dev store used for `shopify app dev` and Playwright e2e
SHOP_CUSTOM_DOMAIN=
E2E_SHOP_DOMAIN=mannon-9iu9ewku.myshopify.com

# --- Database -------------------------------------------------------------
# PostgreSQL in every environment (see docs/adr/0001-postgres-everywhere.md)
DATABASE_URL=postgresql://mannon:mannon@localhost:5432/mannon_dev?schema=public

# --- Billing --------------------------------------------------------------
# "true" makes every subscription a Shopify test charge (no money moves).
# Set it on development stores; never in production.
SHOPIFY_BILLING_TEST_MODE=false

# --- Background jobs ------------------------------------------------------
# Required. Without it the runner endpoint refuses to run, which means the
# post-uninstall PII purge never happens (GDPR, 48h). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then schedule, once a minute:
#   curl -fsS -XPOST -H "Authorization: Bearer $JOBS_RUNNER_TOKEN" \
#     https://<app-url>/internal/jobs/run
JOBS_RUNNER_TOKEN=

# --- Outgoing email -------------------------------------------------------
# Applicants are told when they are approved or turned down. Without a sender
# nothing is sent, and the app says so on screen rather than pretending — every
# message it would have sent is still recorded, so nothing is lost.
#
# MANNON_EMAIL_TRANSPORT: "resend" (default when a key is set) or "log", which
# writes each message to the log instead of sending it. Useful in development.
MANNON_EMAIL_FROM=
MANNON_EMAIL_TRANSPORT=
MANNON_RESEND_API_KEY=

# --- Anthropic (server-side only; never exposed to the client) -------------
# Absence must degrade to the manual path, never crash: every AI feature has a
# way to do the same job by hand, and the screens say when they are quiet.
ANTHROPIC_API_KEY=

# The model to ask. Defaults to what the spec names (claude-sonnet-4-5); the
# current-generation equivalent is claude-sonnet-5, and claude-opus-5 is the
# more capable choice. See DECISIONS.md, 2026-09-10.
MANNON_AI_MODEL=
