{% comment %}
  Mannon — wholesale registration form.

  The form itself is served by the app, not rebuilt here. A Liquid copy of the
  builder's fields, validation and conditional logic would be a second
  implementation of the thing that decides whether an application is accepted,
  and the two would drift the first time a field type was added.

  It works with JavaScript switched off: the frame loads and submits on its
  own. The script below only trims the frame to its content so there is no
  inner scrollbar; without it the form is scrollable rather than broken.
{% endcomment %}

{%- assign form_url = block.settings.form_url | strip -%}

<div class="mannon-registration" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="mannon-registration__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {%- if form_url == blank -%}
    {%- comment -%}
      Only the merchant sees this, in the theme editor. A buyer on the live
      storefront gets nothing at all rather than a broken frame.
    {%- endcomment -%}
    {%- if request.design_mode -%}
      <p class="mannon-registration__setup">{{ 'mannon.registration.needs_url' | t }}</p>
    {%- endif -%}
  {%- else -%}
    <iframe
      class="mannon-registration__frame"
      id="mannon-registration-{{ block.id }}"
      src="{{ form_url }}"
      title="{{ block.settings.heading | default: 'Wholesale registration' | escape }}"
      loading="lazy"
      style="width:100%;border:0;min-height:{{ block.settings.height }}px;"
    ></iframe>

    <p class="mannon-registration__fallback">
      <a href="{{ form_url }}" target="_blank" rel="noopener">
        {{ 'mannon.registration.open_in_new_tab' | t }}
      </a>
    </p>

    <script>
      // Progressive enhancement only. The frame is usable without this.
      (function () {
        var frame = document.getElementById('mannon-registration-{{ block.id }}');
        if (!frame) return;
        window.addEventListener('message', function (event) {
          if (!event.data || event.data.type !== 'mannon:height') return;
          if (frame.contentWindow !== event.source) return;
          var height = parseInt(event.data.height, 10);
          if (height > 0 && height < 5000) frame.style.height = height + 'px';
        });
      })();
    </script>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Wholesale registration",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Apply for a wholesale account"
    },
    {
      "type": "url",
      "id": "form_url",
      "label": "Form link",
      "info": "Copy this from the Publish tab of your form in the Mannon app."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 400,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 900,
      "info": "Used until the form reports its own height. A taller value avoids a scrollbar inside the form."
    }
  ],
  "presets": [{ "name": "Wholesale registration" }]
}
{% endschema %}
