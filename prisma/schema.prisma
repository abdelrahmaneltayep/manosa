// Mannon — B2B Wholesale Pricing
//
// Multi-tenancy rule: every model that holds merchant data carries a `shop`
// column. The Prisma client extension in app/lib/tenant/shop-scope.server.ts
// derives the scoped-model set from the DMMF at runtime — a model gets tenant
// isolation the moment it has a `shop` field, with no registration step to
// forget. Models that must stay unscoped are listed explicitly in
// UNSCOPED_MODELS there, and each one needs a comment saying why.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify OAuth sessions. Managed by @shopify/shopify-app-session-storage-prisma.
/// UNSCOPED on purpose: session lookup happens during OAuth, before a shop
/// context exists. The library's own queries are already keyed by shop or id.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

/// One row per installed store. Created on first authenticated request and
/// soft-closed by the app/uninstalled webhook (Phase 0.2) so we keep the
/// install history without keeping PII.
model Shop {
  id            String    @id @default(cuid())
  /// The myshopify.com domain. Tenant key for every other table.
  shop          String    @unique
  name          String?
  email         String?
  countryCode   String?
  currencyCode  String?
  ianaTimezone  String?
  primaryLocale String    @default("en")
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  /// Set by the Danger zone "pause app" control (Settings, Phase 6.2).
  /// While paused, pricing rules stop applying but nothing is deleted.
  pausedAt      DateTime?
  /// Set when the post-uninstall PII purge has run (GDPR, within 48h).
  piiPurgedAt   DateTime?

  // --- Billing (phase 0.3) -----------------------------------------------
  // Shopify is the source of truth; this is a cache so the gate can answer on
  // every request without an Admin API round trip. Kept fresh by the
  // app_subscriptions/update webhook, and re-synced when it goes stale.
  planKey            String        @default("free")
  billingStatus      BillingStatus @default(NONE)
  billingInterval    String?
  subscriptionId     String?
  subscriptionName   String?
  isTestSubscription Boolean       @default(false)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  /// End of the 7-day grace period after a failed charge. Features keep
  /// working until then; nothing is ever deleted.
  graceEndsAt        DateTime?
  billingSyncedAt    DateTime?

  // --- Discount function wiring (phase 1.2) ------------------------------
  /// The automatic app discount that runs Mannon's Function at checkout.
  discountId         String?
  /// The deployed Function this shop's discount points at.
  discountFunctionId String?
  /// Hash of the last published ruleset, so an unchanged ruleset is not
  /// re-pushed to Shopify every time a rule is saved.
  rulesetHash        String?
  rulesetPublishedAt DateTime?
  /// How many rules were in the last publish, for the Pricing page to show
  /// what is actually live at checkout.
  rulesetRuleCount   Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([uninstalledAt])
}

// ---------------------------------------------------------------------------
// Billing (phase 0.3)
// ---------------------------------------------------------------------------

enum BillingStatus {
  /// No subscription: the shop is on Free.
  NONE
  /// Inside the 14-day trial of a paid plan.
  TRIAL
  ACTIVE
  /// Charge failed. Shopify freezes the subscription; we keep the paid plan
  /// working through a 7-day grace period rather than cutting access instantly.
  PAST_DUE
  /// Merchant cancelled, or the subscription expired. Paid features pause and
  /// the data behind them is kept intact.
  CANCELLED
}

// ---------------------------------------------------------------------------
// Audit log (phase 0.2)
// ---------------------------------------------------------------------------

enum AuditActorType {
  /// A person in the Shopify admin.
  STAFF
  /// The admin copilot drafting on the merchant's behalf.
  MERCHANT_AGENT
  /// The storefront concierge acting for a buyer.
  BUYER_AGENT
  /// A wholesale customer on the storefront.
  BUYER
  /// Webhooks, scheduled jobs, migrations.
  SYSTEM
}

/// Every consequential action, and every AI action without exception.
///
/// Settings → Agent controls reads this filtered by actor, action and date
/// (phase 6.2), and each AI row links back to the artifact it produced. The
/// trust promise depends on this table being complete, so writes are part of
/// the caller's transaction rather than fire-and-forget.
model AuditLog {
  id        String   @id @default(cuid())
  shop      String
  createdAt DateTime @default(now())

  actorType  AuditActorType
  /// Staff user id, customer id, or the agent's identifier.
  actorId    String?
  /// Display name captured at write time, so the log still reads correctly
  /// after the person is removed from the store.
  actorLabel String?

  /// Dotted action name, e.g. "pricing_rule.created", "ai.draft.approved".
  action  String
  /// Human sentence rendered in the log UI.
  summary String

  subjectType String?
  subjectId   String?
  metadata    Json?

  // --- AI provenance. Set together or not at all. ------------------------
  aiModel         String?
  aiPromptVersion String?
  aiRequestId     String?

  /// True when this action changed live data on an AI suggestion. Such a row
  /// is only valid with approvedById + approvedAt: no AI write path may mutate
  /// live pricing or customers without a merchant approval recorded here.
  aiAssisted   Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?

  /// Correlates with the HTTP request that produced it.
  requestId String?
  ip        String?

  @@index([shop, createdAt])
  @@index([shop, actorType, createdAt])
  @@index([shop, action, createdAt])
  @@index([shop, subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Webhook framework (phase 0.2)
// ---------------------------------------------------------------------------

/// One row per accepted webhook delivery, so Shopify's at-least-once retries
/// are idempotent. Shopify retries for up to 48h; rows older than that are no
/// longer needed (pruning lands with the retention jobs in phase 7.2).
model WebhookDelivery {
  id         String    @id @default(cuid())
  shop       String
  /// X-Shopify-Webhook-Id. Unique per delivery, stable across retries.
  webhookId  String
  topic      String
  receivedAt DateTime  @default(now())
  /// Null until the handler succeeds; a retry of a failed delivery re-runs.
  handledAt  DateTime?
  attempts   Int       @default(0)
  lastError  String?

  @@unique([shop, webhookId])
  @@index([shop, receivedAt])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Scheduled jobs (phase 0.2)
// ---------------------------------------------------------------------------

enum ScheduledJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// Superseded before it ran — e.g. a PII purge cancelled by a reinstall.
  CANCELLED
}

/// A deliberately small durable queue: enough for "do this later, exactly
/// once, and survive a restart" without adding a broker. The runner is driven
/// by cron (`npm run jobs:run`).
model ScheduledJob {
  id     String             @id @default(cuid())
  shop   String
  kind   String
  status ScheduledJobStatus @default(PENDING)

  runAt       DateTime
  payload     Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([shop, kind, status])
}
