// Mannon — B2B Wholesale Pricing
//
// Multi-tenancy rule: every model that holds merchant data carries a `shop`
// column. The Prisma client extension in app/lib/tenant/shop-scope.server.ts
// derives the scoped-model set from the DMMF at runtime — a model gets tenant
// isolation the moment it has a `shop` field, with no registration step to
// forget. Models that must stay unscoped are listed explicitly in
// UNSCOPED_MODELS there, and each one needs a comment saying why.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify OAuth sessions. Managed by @shopify/shopify-app-session-storage-prisma.
/// UNSCOPED on purpose: session lookup happens during OAuth, before a shop
/// context exists. The library's own queries are already keyed by shop or id.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

/// One row per installed store. Created on first authenticated request and
/// soft-closed by the app/uninstalled webhook (Phase 0.2) so we keep the
/// install history without keeping PII.
model Shop {
  id            String  @id @default(cuid())
  /// The myshopify.com domain. Tenant key for every other table.
  shop          String  @unique
  /// Shopify's own GID for the shop, e.g. "gid://shopify/Shop/1234". Needed to
  /// own a shop metafield; read once and cached because it never changes.
  shopGid       String?
  name          String?
  email         String?
  countryCode   String?
  currencyCode  String?
  ianaTimezone  String?
  primaryLocale String  @default("en")

  /// Briefing item kinds the merchant has asked not to see again — the
  /// checklist's per-type mute list. Kinds, not items: "don't show me this
  /// type again" is about the type.
  briefingMuted String[]

  // --- Agent controls (phase 6.5) ------------------------------------------
  /// What Claude may do without being asked, per checklist §8.
  ///
  /// Before these existed, every ✦ surface was gated on `isAiAvailable()`
  /// alone — so whether an environment variable was set was the only answer a
  /// merchant had to "may Claude screen my applicants". A capability with no
  /// switch is a decision this app made on their behalf.
  /// Checklist §8 asks for a third — auto-approve — and it is deliberately
  /// absent: nothing in this app approves an application without a person, so
  /// a toggle for it would be a control for behaviour the product does not
  /// have. It arrives with auto-approval, defaulting off (Invariant 3).
  aiMayScreen Boolean @default(true)
  aiMayDraft  Boolean @default(true)

  /// The last time this shop's storefront called our App Proxy.
  ///
  /// This is how the setup checklist knows the theme blocks are live without
  /// the `themes` protected scope: a proxy request can only come from a theme
  /// that is actually rendering them. Absence proves nothing, and the checklist
  /// says so rather than claiming the embed is off — see docs/adr/0022.
  storefrontSeenAt DateTime?
  /// The merchant saying "I turned it on", for a store whose storefront has not
  /// called us yet. Their word, recorded as their word.
  embedConfirmedAt DateTime?

  /// Set when the merchant finishes or dismisses the setup checklist, so a
  /// completed checklist collapses to a pill and stays collapsed.
  setupDismissedAt DateTime?

  /// When the last attempt to write a briefing failed, and why.
  ///
  /// Without this the home page cannot tell "the agent had nothing to say"
  /// from "the agent could not be reached", and shows yesterday's briefing as
  /// though it were today's. Cleared on the next success.
  briefingFailedAt     DateTime?
  briefingFailedReason String?

  /// The month whose review was attempted and could not be written, and why.
  ///
  /// Same reason the briefing has its pair: without it the review page cannot
  /// tell "not written yet" from "we tried and failed", and told a merchant
  /// their first review was still coming about a month it had given up on.
  /// Cleared on the next success.
  reviewFailedMonth  String?
  reviewFailedAt     DateTime?
  reviewFailedReason String?
  installedAt        DateTime  @default(now())
  uninstalledAt      DateTime?
  /// Set by the Danger zone "pause app" control (Settings, phase 6.4).
  /// While paused an empty ruleset is published, so the Function stops
  /// discounting at checkout, and the App Proxy refuses. Nothing is
  /// deleted: every rule stays here and resume republishes them.
  pausedAt           DateTime?
  /// When the empty ruleset actually reached Shopify.
  ///
  /// Derived signals do not work here: `rulesetRuleCount` is 0 both for a
  /// pause that landed and for a shop that has never published, and the page
  /// must not say "no wholesale price is being applied anywhere" about a shop
  /// whose checkout is still discounting because the publish threw.
  pausePublishedAt   DateTime?
  /// Set when the post-uninstall PII purge has run (GDPR, within 48h).
  piiPurgedAt        DateTime?

  // --- Billing (phase 0.3) -----------------------------------------------
  // Shopify is the source of truth; this is a cache so the gate can answer on
  // every request without an Admin API round trip. Kept fresh by the
  // app_subscriptions/update webhook, and re-synced when it goes stale.
  planKey            String        @default("free")
  billingStatus      BillingStatus @default(NONE)
  billingInterval    String?
  subscriptionId     String?
  subscriptionName   String?
  isTestSubscription Boolean       @default(false)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  /// End of the 7-day grace period after a failed charge. Features keep
  /// working until then; nothing is ever deleted.
  graceEndsAt        DateTime?
  billingSyncedAt    DateTime?

  // --- Discount function wiring (phase 1.2) ------------------------------
  /// The automatic app discount that runs Mannon's Function at checkout.
  discountId         String?
  /// The deployed Function this shop's discount points at.
  discountFunctionId String?
  /// Hash of the last published ruleset, so an unchanged ruleset is not
  /// re-pushed to Shopify every time a rule is saved.
  rulesetHash        String?
  rulesetPublishedAt DateTime?
  /// How many rules were in the last publish, for the Pricing page to show
  /// what is actually live at checkout.
  rulesetRuleCount   Int       @default(0)

  // --- Customers (phase 2.1) ---------------------------------------------
  /// The tag that means "this buyer is wholesale". Configurable because every
  /// store already has its own word for it, and re-tagging an existing
  /// customer base to suit us would be rude. Settings exposes it in 6.2.
  wholesaleTag           String  @default("wholesale")
  /// When on, a buyer cannot be marked tax-exempt without a VAT id on file.
  requireVatForTaxExempt Boolean @default(false)
  /// The storefront the merchant actually uses. Needed so the registration
  /// form can be framed by their theme without allowing every origin to frame
  /// it. Refreshed when a form is published.
  primaryDomain          String?

  /// When the shop's own facts — currency, timezone, name — were last read
  /// from Shopify. Null means never, and every money figure in the admin is
  /// then labelled with the fallback currency rather than the real one.
  shopFactsSyncedAt DateTime?

  // --- Orders and limits (phase 3.1) --------------------------------------
  /// Tag put on an order placed by a wholesale buyer, so the merchant can find
  /// them in Shopify's own admin as well as here.
  wholesaleOrderTag String    @default("wholesale")
  /// Orders placed in person bypass online order limits. On by default: a
  /// minimum written for a website is not a rule about a till.
  posBypassesLimits Boolean   @default(true)
  /// Hash of the last published limits, so an unchanged set is not re-pushed.
  limitsHash        String?
  limitsPublishedAt DateTime?

  // --- Net terms (phase 3.2) ---------------------------------------------
  /// The manual payment method a merchant set up for paying later. The Function
  /// hides it from everyone who is not eligible.
  termsMethodName    String    @default("Net terms")
  /// Rename it at checkout to say the terms: "Pay later (Net 30)".
  termsShowDays      Boolean   @default(true)
  /// An unpaid invoice past its due date stops further credit.
  termsOverdueBlocks Boolean   @default(true)
  termsSettingsHash  String?
  termsPublishedAt   DateTime?

  // --- Quotes (phase 3.3) -------------------------------------------------
  /// How long a sent quote stands. Copied onto the quote when it is sent, so
  /// changing this never moves a date a buyer has already been given.
  quoteExpiryDays        Int       @default(14)
  /// How many days before expiry the buyer is warned. Once per quote.
  quoteReminderDays      Int       @default(3)
  /// Sequence behind the "Q-1001" a merchant reads out.
  quoteCounter           Int       @default(1000)
  /// The deployed payment customization Function, and the customization that
  /// points at it.
  paymentFunctionId      String?
  paymentCustomizationId String?
  /// Progress of the one-off order backfill.
  ordersBackfilledAt     DateTime?
  ordersBackfillCursor   String?

  /// Progress of the one-off customer backfill. Null means never finished.
  customersBackfilledAt   DateTime?
  /// Where the backfill got to. A store with 40,000 customers takes many
  /// pages, and a restart in the middle must not start again from the top.
  customersBackfillCursor String?
  customerCount           Int       @default(0)

  // --- Settings (phase 6.4) ------------------------------------------------
  /// Show the retail price struck through beside the wholesale one. Off for
  /// merchants whose trade buyers should never see retail at all.
  showCompareAt         Boolean @default(true)
  /// "Log in to see prices" — a signed-out visitor sees no price and no
  /// add-to-cart, rather than a retail price the buyer would never pay.
  hidePricesFromGuests  Boolean @default(false)
  /// Whether storefront prices read as tax-inclusive or tax-exclusive. Display
  /// only: Shopify still decides what is charged.
  taxDisplay            String  @default("excl")
  /// Whether a wholesale price may stack with a Shopify discount code. Off by
  /// default — stacking is how a trade price accidentally becomes a giveaway.
  /// Per-rule `combinable` still applies; this is the store-wide gate.
  allowShopifyDiscounts Boolean @default(false)
  /// The combination setting as last pushed to the live discount, so a rule
  /// save does not re-state a choice that has not moved.
  combinationsHash      String?

  /// The address the app sends from, and the domain it belongs to.
  ///
  /// Unverified means mail goes out on the app's own domain with the merchant
  /// told so — never "verified" for a domain nobody has checked.
  senderEmail      String?
  senderDomain     String?
  senderVerifiedAt DateTime?
  /// The DNS records the merchant has to add, as the provider gave them.
  senderDnsRecords Json?
  /// When the records were last checked, and what came back. Null means never
  /// checked, which the page says rather than implying a failure.
  senderCheckedAt  DateTime?
  senderCheckError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uninstalledAt])
}

// ---------------------------------------------------------------------------
// Billing (phase 0.3)
// ---------------------------------------------------------------------------

enum BillingStatus {
  /// No subscription: the shop is on Free.
  NONE
  /// Inside the 14-day trial of a paid plan.
  TRIAL
  ACTIVE
  /// Charge failed. Shopify freezes the subscription; we keep the paid plan
  /// working through a 7-day grace period rather than cutting access instantly.
  PAST_DUE
  /// Merchant cancelled, or the subscription expired. Paid features pause and
  /// the data behind them is kept intact.
  CANCELLED
}

// ---------------------------------------------------------------------------
// Audit log (phase 0.2)
// ---------------------------------------------------------------------------

enum AuditActorType {
  /// A person in the Shopify admin.
  STAFF
  /// The admin copilot drafting on the merchant's behalf.
  MERCHANT_AGENT
  /// The storefront concierge acting for a buyer.
  BUYER_AGENT
  /// A wholesale customer on the storefront.
  BUYER
  /// Webhooks, scheduled jobs, migrations.
  SYSTEM
}

/// Every consequential action, and every AI action without exception.
///
/// Settings → Agent controls reads this filtered by actor, action and date
/// (phase 6.2), and each AI row links back to the artifact it produced. The
/// trust promise depends on this table being complete, so writes are part of
/// the caller's transaction rather than fire-and-forget.
model AuditLog {
  id        String   @id @default(cuid())
  shop      String
  createdAt DateTime @default(now())

  actorType  AuditActorType
  /// Staff user id, customer id, or the agent's identifier.
  actorId    String?
  /// Display name captured at write time, so the log still reads correctly
  /// after the person is removed from the store.
  actorLabel String?

  /// Dotted action name, e.g. "pricing_rule.created", "ai.draft.approved".
  action  String
  /// Human sentence rendered in the log UI.
  summary String

  subjectType String?
  subjectId   String?
  metadata    Json?

  // --- AI provenance. Set together or not at all. ------------------------
  aiModel         String?
  aiPromptVersion String?
  aiRequestId     String?

  /// True when this action changed live data on an AI suggestion. Such a row
  /// is only valid with approvedById + approvedAt: no AI write path may mutate
  /// live pricing or customers without a merchant approval recorded here.
  aiAssisted   Boolean   @default(false)
  approvedById String?
  approvedAt   DateTime?

  /// Correlates with the HTTP request that produced it.
  requestId String?
  ip        String?

  @@index([shop, createdAt])
  @@index([shop, actorType, createdAt])
  @@index([shop, action, createdAt])
  @@index([shop, subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Webhook framework (phase 0.2)
// ---------------------------------------------------------------------------

/// One row per accepted webhook delivery, so Shopify's at-least-once retries
/// are idempotent. Shopify retries for up to 48h; rows older than that are no
/// longer needed (pruning lands with the retention jobs in phase 7.2).
model WebhookDelivery {
  id         String    @id @default(cuid())
  shop       String
  /// X-Shopify-Webhook-Id. Unique per delivery, stable across retries.
  webhookId  String
  topic      String
  receivedAt DateTime  @default(now())
  /// Null until the handler succeeds; a retry of a failed delivery re-runs.
  handledAt  DateTime?
  attempts   Int       @default(0)
  lastError  String?

  @@unique([shop, webhookId])
  @@index([shop, receivedAt])
  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Scheduled jobs (phase 0.2)
// ---------------------------------------------------------------------------

enum ScheduledJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// Superseded before it ran — e.g. a PII purge cancelled by a reinstall.
  CANCELLED
}

/// A deliberately small durable queue: enough for "do this later, exactly
/// once, and survive a restart" without adding a broker. The runner is driven
/// by cron (`npm run jobs:run`).
model ScheduledJob {
  id     String             @id @default(cuid())
  shop   String
  kind   String
  status ScheduledJobStatus @default(PENDING)

  runAt       DateTime
  payload     Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([shop, kind, status])
}

// ---------------------------------------------------------------------------
// Pricing rules (phase 1.3)
// ---------------------------------------------------------------------------

enum PricingRuleStatus {
  DRAFT
  ACTIVE
  /// Soft-deleted. Restorable for 30 days, then permanently removable.
  ARCHIVED
}

enum PricingRuleKind {
  FIXED_PRICE
  VOLUME_TIER
  CART_VALUE_TIER
  AMOUNT_OFF
  PERCENTAGE
}

/// A merchant's pricing rule.
///
/// The JSON columns hold exactly the wire shapes from
/// `@mannon/pricing-engine`'s codec, so a row becomes an engine rule through
/// the same tested code that reads the published ruleset at checkout. There is
/// one definition of a rule's shape, not a database one and an engine one.
model PricingRule {
  id     String            @id @default(cuid())
  shop   String
  name   String
  status PricingRuleStatus @default(DRAFT)
  kind   PricingRuleKind

  /// Lower runs first and wins. Merchants drag a rule up the list to make it
  /// matter more, so "first in the list" means "wins".
  priority   Int     @default(100)
  combinable Boolean @default(false)

  /// Engine wire shapes. See packages/pricing-engine/src/codec.ts.
  value    Json
  targets  Json
  audience Json
  markets  Json

  startsAt DateTime?
  endsAt   DateTime?

  /// Soft delete. Restorable for 30 days; hard delete asks for the rule name.
  archivedAt DateTime?

  /// Bumped on every save. A stale version means another staff member changed
  /// the rule since this editor loaded it.
  version Int @default(1)

  /// Targets that no longer exist in Shopify, kept so the list can say
  /// "1 target missing" rather than silently pricing nothing.
  missingTargetCount Int @default(0)

  /// Times this rule priced a line in the last 30 days. Filled in by analytics
  /// (phase 6.1); null means "not measured yet", which is not the same as zero.
  usageCount30d Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([shop, status, priority])
  @@index([shop, archivedAt])
  @@index([shop, updatedAt])
}

// ---------------------------------------------------------------------------
// CSV imports (phase 1.4)
// ---------------------------------------------------------------------------

/// One import run, kept so it can be undone.
///
/// Undo is a single click within an hour — a merchant who imported the wrong
/// file should not have to delete two hundred rules by hand.
model RuleImport {
  id       String @id @default(cuid())
  shop     String
  fileName String
  template String

  rowCount     Int
  createdCount Int
  errorCount   Int
  warningCount Int

  /// Ids of the rules this import created, for undo.
  createdRuleIds String[]

  /// Undo is offered until this time.
  undoableUntil DateTime
  undoneAt      DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([shop, createdAt])
}

/// An uploaded file waiting for the merchant to accept or reject its dry run.
///
/// Held server-side because a browser will not resubmit a file input: the
/// review step has to be able to import exactly the bytes that were checked,
/// not ask for the file again. Deleted the moment it is used or abandoned.
model RuleImportDraft {
  id       String @id @default(cuid())
  shop     String
  fileName String
  content  String

  /// ✦ CSV whisperer (phase 4.3): the merchant's confirmed header → column
  /// mapping, so confirming imports exactly the file that was reviewed. Null
  /// when the file's own headers already matched a template.
  mapping  Json?
  /// The template the mapping targets. Null means "detect it from the headers",
  /// which is what a file that needed no mapping does.
  template String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

// ---------------------------------------------------------------------------
// Customers (phase 2.1)
// ---------------------------------------------------------------------------

/// A wholesale tier: Silver, Gold, VIP.
///
/// A group is a *bundle*, not a label — pricing rules, order limits, payment
/// terms, shipping rules and product visibility all hang off it. The fields
/// whose features land in later phases are stored here from the start so the
/// group page can show the whole bundle rather than growing a new table each
/// time a phase adds a section.
model CustomerGroup {
  id          String  @id @default(cuid())
  shop        String
  name        String
  /// Stable key used in pricing-rule audiences and in CSV imports, so renaming
  /// a group does not silently repoint every rule that referenced it.
  handle      String
  color       String?
  description String?

  /// Members of a group are priced by rules whose audience names it, and are
  /// tagged with this in Shopify so the storefront and checkout agree.
  tag String

  // --- Bundle: each of these is owned by a later phase, shown here now. ----
  /// Net payment terms in days.
  netTermsDays         Int?
  /// The most a member may owe at once, in minor units. Null means no ceiling.
  /// A limit without days is not an agreement — see `@mannon/net-terms`.
  creditLimit          Int?
  /// Free shipping above this subtotal, in minor units. Phase 3.
  freeShippingOver     Int?
  /// Collections this group may see. Empty means everything. Phase 3.4.
  visibleCollectionIds String[]

  /// Groups created from a starter template say so, so the empty state can
  /// stop offering a template the merchant already took.
  template String?

  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  members Customer[]
  limits  OrderLimit[]

  @@unique([shop, handle])
  @@index([shop, sortOrder])
}

/// What Mannon knows about a Shopify customer.
///
/// A mirror, not a second source of truth: Shopify owns the customer, and this
/// row exists so the buyers list can be searched, filtered and paginated
/// without an Admin API round trip per keystroke, and so a customer deleted in
/// Shopify can still be shown as deleted rather than vanishing mid-list.
model Customer {
  id         String @id @default(cuid())
  shop       String
  /// Shopify's GID. The join key to everything on their side.
  customerId String

  email       String?
  firstName   String?
  lastName    String?
  /// Default address company, which is what wholesale buyers are known by.
  company     String?
  phone       String?
  countryCode String?
  province    String?

  /// Shopify's tags, normalised (trimmed, de-duplicated, sorted).
  tags  String[]
  /// Shopify's account state: enabled, disabled, invited, declined.
  state String   @default("enabled")

  taxExempt     Boolean   @default(false)
  /// EU/GCC VAT id. Collected by the registration form (2.2) and validated
  /// against VIES there; stored here so tax-exempt can require it.
  vatNumber     String?
  /// Set when VIES confirmed the number. Null means unverified, which is not
  /// the same as invalid — VIES outages must not brand a buyer as fraudulent.
  vatVerifiedAt DateTime?

  groupId String?
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  status BuyerStatus @default(APPROVED)

  /// Shopify's own totals, in minor units of `currencyCode`. Not a price we
  /// computed — every *price* in this app comes from the pricing engine.
  lifetimeSpend Int       @default(0)
  currencyCode  String    @default("USD")
  orderCount    Int       @default(0)
  lastOrderAt   DateTime?

  // --- Net terms (phase 3.2) ----------------------------------------------
  /// This buyer's own terms, which replace their group's rather than merging
  /// with them. Null means "whatever their group says".
  netTermsDays Int?
  /// Their own credit ceiling, in minor units of `currencyCode`.
  creditLimit  Int?
  /// Opt-in, per the checklist: reminders are drafted for the merchant to send
  /// unless this buyer has agreed to automatic ones.
  autoRemind   Boolean @default(false)

  /// Staff-only. Never shown to the buyer and never sent in an email.
  internalNote String?

  /// Set by the customers/delete webhook. The row is kept so an open list does
  /// not lose a row mid-scroll, and so history survives; the cleanup job
  /// removes it later.
  deletedInShopifyAt DateTime?

  /// Last time this row was written from Shopify's copy.
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, customerId])
  @@index([shop, status, lastOrderAt])
  @@index([shop, groupId])
  @@index([shop, email])
  @@index([shop, deletedInShopifyAt])
}

enum BuyerStatus {
  /// Applied through a registration form and waiting on a decision (2.3).
  PENDING
  /// Can buy at wholesale prices. Every customer synced from Shopify starts
  /// here: they already have an account and can already place orders.
  APPROVED
  REJECTED
}

/// One rule of the auto-tagging engine.
///
/// Conditions are the wire shape from app/lib/customers/tagging.ts, which is a
/// pure module — the same code decides a match in a preview, in a webhook, and
/// in the nightly sweep, so a merchant's preview cannot disagree with what
/// actually happens.
model CustomerTagRule {
  id       String  @id @default(cuid())
  shop     String
  name     String
  enabled  Boolean @default(true)
  /// Lower runs first, matching the pricing rules' convention.
  priority Int     @default(100)

  /// "all" or "any" — how the conditions combine.
  matchMode  String @default("all")
  conditions Json

  addTags    String[]
  removeTags String[]

  lastRunAt      DateTime?
  lastMatchCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@index([shop, enabled, priority])
}

// ---------------------------------------------------------------------------
// Registration forms (phase 2.2)
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  LIVE
}

/// A wholesale registration form.
///
/// The JSON columns hold the wire shapes from app/lib/forms/schema.ts, which is
/// a pure module: the same definition validates a submission in the admin
/// preview, on the standalone page, and behind the app proxy. A form that
/// validates one way in the builder and another way for a buyer is the kind of
/// bug that only shows up as applications that never arrive.
model RegistrationForm {
  id     String     @id @default(cuid())
  shop   String
  name   String
  /// URL slug, unique per shop. Duplicating a form appends "-copy".
  slug   String
  status FormStatus @default(DRAFT)

  /// The public link. Unguessable and shop-free, so a standalone form URL does
  /// not have to carry the merchant's domain or reveal their other forms.
  publicId String @unique @default(cuid())

  /// FormDefinition — fields, their validation, and conditional logic.
  fields     Json
  /// Layout, width, font and colours.
  appearance Json
  /// Confirmation / approved / rejected / needs-info templates.
  emails     Json
  /// Redirect URL, auto-tags, auto-group, spam protection.
  publish    Json
  /// Auto-approval criteria — the wire shape from app/lib/forms/approval.ts.
  /// Null means every application waits for a person, which is the default:
  /// deciding on its own is something a merchant has to switch on.
  approval   Json?

  /// Which starter template this began as, if any.
  template String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  submissions FormSubmission[]
  events      FormEvent[]

  @@unique([shop, slug])
  @@index([shop, status, updatedAt])
}

/// What Claude made of an application. A recommendation, never a decision:
/// only a merchant approves, and every state here leaves both buttons live.
enum ScreeningVerdict {
  /// Not screened yet.
  WAITING
  /// Nothing about it looks wrong.
  RECOMMEND
  /// Something is worth a person's attention before approving.
  LOOK
  /// Screening ran and could not answer — no key, a timeout, a refusal. Said
  /// out loud rather than shown as a clean bill of health.
  UNAVAILABLE
  /// The merchant has no criteria and no key: nothing was ever attempted.
  OFF
}

enum SubmissionStatus {
  /// Waiting on a merchant decision. The approval pipeline is phase 2.3.
  PENDING
  APPROVED
  REJECTED
  /// Caught by spam protection. Kept, not deleted: a false positive is a lost
  /// customer, and the merchant needs to be able to find one.
  SPAM
}

enum VatCheckStatus {
  /// No VAT id was given.
  NONE
  /// VIES confirmed it.
  VALID
  /// VIES said no.
  INVALID
  /// VIES could not be reached, or the country is outside the EU. Accepted
  /// with a flag — a third-party outage must never block an applicant.
  UNVERIFIED
}

/// One application.
model FormSubmission {
  id     String           @id @default(cuid())
  shop   String
  formId String
  form   RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  /// Pulled out of the answers so duplicates can be found without parsing JSON.
  email   String
  company String?
  /// Every answer, keyed by field key.
  answers Json

  status SubmissionStatus @default(PENDING)

  vatNumber String?
  vatStatus VatCheckStatus @default(NONE)
  /// Why the VAT id is unverified, for the reviewer: "vies_unreachable",
  /// "outside_eu", "format".
  vatNote   String?

  /// Set when spam protection caught it, so a merchant reviewing a false
  /// positive can see what tripped: "honeypot", "too_fast", "rate_limit".
  spamReason String?

  /// Kept for rate limiting and for the reviewer. Purged with the rest of the
  /// PII on uninstall.
  ip        String?
  userAgent String?

  /// The Shopify customer this application became, once approved.
  customerId String?

  // --- The decision (phase 2.3) --------------------------------------------
  decidedAt            DateTime?
  /// Staff session id, or null when the evaluator decided.
  decidedBy            String?
  /// True when the auto-approval criteria decided this, not a person.
  decidedAutomatically Boolean   @default(false)
  /// Why it was rejected: a code from REJECTION_REASONS, plus whatever the
  /// reviewer typed. A rejection with no reason is one nobody can answer for.
  rejectionCode        String?
  decisionNote         String?
  /// Approve can be undone until this time. Ten seconds — long enough to catch
  /// the wrong row, short enough that nothing has acted on it yet.
  undoableUntil        DateTime?
  /// When the auto-approval criteria last looked at this. Null means the
  /// evaluator has not seen it yet, which is what the job claims work by.
  autoEvaluatedAt      DateTime?

  // --- ✦ Screening (phase 4.3) ---------------------------------------------
  /// Claude's read on this application. WAITING means the screening job has
  /// not reached it yet, which the queue shows as "checking"; UNAVAILABLE means
  /// it ran and could not answer, which is not the same as "nothing found".
  screening              ScreeningVerdict @default(WAITING)
  /// Up to three plain-language reasons, each tied to a fact the app holds.
  /// Never the applicant's own words — see docs/adr/0020.
  screeningReasons       Json?
  /// When the screening last ran. Null means never, and is what the job claims
  /// work by. A screened application is never screened again.
  screenedAt             DateTime?
  /// Provenance, so a verdict a merchant disagrees with can be traced to the
  /// prompt and model that produced it.
  screeningModel         String?
  screeningPromptVersion String?
  screeningRequestId     String?

  createdAt DateTime @default(now())

  uploads FormUpload[]

  @@index([shop, status, createdAt])
  @@index([shop, formId, createdAt])
  @@index([shop, email])
  @@index([shop, ip, createdAt])
}

/// A file an applicant attached — a trade licence, a tax certificate.
///
/// Stored in the database rather than object storage: these are a few hundred
/// kilobytes each, arriving a handful a day, and adding a bucket to the
/// deployment for that would be a worse trade than a bytea column.
model FormUpload {
  id           String          @id @default(cuid())
  shop         String
  submissionId String?
  submission   FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  fieldKey    String
  fileName    String
  contentType String
  byteSize    Int
  content     Bytes

  /// Null means not scanned. The admin says so rather than implying it is
  /// clean — claiming a scan that never ran is worse than admitting there is
  /// none. See QA-REPORT 2.2.
  scannedAt     DateTime?
  /// Set if a scanner ever finds something.
  quarantinedAt DateTime?

  createdAt DateTime @default(now())

  @@index([shop, submissionId])
}

enum FormEventKind {
  VIEW
  SUBMIT
}

/// Views and submissions, so the form card can show a real conversion rate.
///
/// Rows rather than counters because "in the last 30 days" needs timestamps.
/// Pruned with the retention jobs in 7.2.
model FormEvent {
  id     String           @id @default(cuid())
  shop   String
  formId String
  form   RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  kind   FormEventKind
  at     DateTime         @default(now())

  @@index([shop, formId, kind, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Approval pipeline (phase 2.3)
// ---------------------------------------------------------------------------

/// An email domain the merchant has closed the door on.
///
/// Applications from it are rejected on arrival, without telling the sender
/// which door was shut — a blocklist a spammer can probe is a blocklist that
/// tells them what to change.
model BlockedDomain {
  id     String @id @default(cuid())
  shop   String
  /// Lowercased, without a leading @.
  domain String

  reason    String?
  createdAt DateTime @default(now())
  createdBy String?

  @@unique([shop, domain])
  @@index([shop, createdAt])
}

enum EmailStatus {
  /// Written, not yet handed to a provider.
  QUEUED
  SENT
  /// The provider refused it, or there is no provider at all.
  FAILED
}

/// Every message the app sends a buyer.
///
/// Recorded before it is sent and updated after, so "did they ever hear from
/// us?" has an answer that does not depend on a provider's dashboard. A
/// merchant answering an applicant who says they got nothing needs this.
model EmailMessage {
  id   String @id @default(cuid())
  shop String

  /// "confirmation", "approved", "rejected", "needs_info".
  kind    String
  to      String
  subject String
  body    String

  status    EmailStatus @default(QUEUED)
  /// Why it failed, in the words the provider used.
  error     String?
  sentAt    DateTime?
  /// Which transport carried it, or tried to.
  transport String?

  /// The application it is about, when it is about one.
  submissionId String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, submissionId])
  @@index([shop, status])
}

// ---------------------------------------------------------------------------
// Orders (phase 3.1)
// ---------------------------------------------------------------------------

/// How an order reached us.
///
/// Attribution matters because the whole product is a claim about where
/// wholesale revenue comes from. A merchant who cannot tell an order the agent
/// produced from one the buyer typed in themselves has no way to judge either.
enum OrderSource {
  /// The normal storefront.
  STOREFRONT
  /// Mannon's quick-order block (phase 3.4).
  QUICK_ORDER
  /// The storefront Buyer Agent (phase 5).
  BUYER_AGENT
  /// A draft order, including an accepted quote (phase 3.3).
  DRAFT
  /// Shopify POS.
  POS
  /// Somewhere we do not recognise. Never guessed at.
  OTHER
}

/// A mirror of a Shopify order, for the wholesale list.
///
/// Same reasoning as the customer mirror (`docs/adr/0010`): the list has to
/// filter, sort and paginate, and `orders(query:)` cannot serve that. Shopify
/// owns the order; nothing here is authoritative, and nothing here is a price
/// this app computed.
model Order {
  id      String @id @default(cuid())
  shop    String
  /// Shopify's GID.
  orderId String
  /// The order number as the merchant says it out loud: "#1001".
  name    String

  /// Shopify's customer GID, when the order has one.
  customerId String?
  email      String?
  company    String?

  /// Shopify's own statuses, lowercased: "paid", "pending", "refunded",
  /// "partially_refunded", "voided".
  financialStatus   String?
  fulfillmentStatus String?

  /// Totals in minor units of `currencyCode`. Shopify's numbers, not ours.
  totalPrice     Int    @default(0)
  subtotalPrice  Int    @default(0)
  refundedAmount Int    @default(0)
  currencyCode   String @default("USD")
  totalQuantity  Int    @default(0)

  source     OrderSource @default(STOREFRONT)
  /// The raw `sourceName` Shopify reported, kept because our mapping of it is
  /// a guess and the original is not.
  sourceName String?

  tags        String[]
  /// True when the buyer was a wholesale customer at the time of the order.
  isWholesale Boolean  @default(false)

  /// Net terms due date. Filled in by phase 3.2; the list already renders the
  /// states that depend on it.
  netTermsDueAt DateTime?
  /// Days of terms the buyer had *at the time*, for the "Net 30" chip. Stored
  /// on the order because changing a buyer's terms applies to new orders only.
  netTermsDays  Int?
  /// Received against this order so far, in minor units. Partial payments are
  /// a fact of wholesale; an invoice that is only paid or unpaid makes the
  /// merchant do the arithmetic themselves.
  amountPaid    Int       @default(0)
  paidAt        DateTime?
  /// Last time a reminder went out, so the ledger does not offer to send a
  /// second one an hour later.
  remindedAt    DateTime?

  payments Payment[]
  lines    OrderLine[]

  processedAt DateTime
  cancelledAt DateTime?

  /// Shopify's `updatedAt` when we last wrote this row, and the one Shopify
  /// reported most recently. When they differ the list shows a resync badge
  /// rather than quietly showing a stale total.
  shopifyUpdatedAt DateTime?
  syncedAt         DateTime  @default(now())
  /// Set when an order was edited in Shopify after we mirrored it.
  needsResync      Boolean   @default(false)

  /// True when Shopify returned fewer lines than this order actually has.
  ///
  /// Lines are fetched with a cap rather than paginated per order, so a very
  /// large order can arrive short. Recorded rather than ignored: a chart built
  /// on lines has to be able to say it is missing some, and the orders with the
  /// most lines are the merchant's biggest.
  linesTruncated Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, processedAt])
  @@index([shop, isWholesale, processedAt])
  @@index([shop, netTermsDueAt])
  @@index([shop, customerId])
}

// ---------------------------------------------------------------------------
// Order limits (phase 3.1)
// ---------------------------------------------------------------------------

/// What a buyer's cart has to satisfy before they can check out.
///
/// One row per group, plus at most one row with no group, which applies to
/// every wholesale buyer the group rows do not cover. Limits are enforced by a
/// cart validation Function, so the numbers here are published to a shop
/// metafield exactly as the pricing ruleset is.
/// A payment received against an order on terms.
///
/// Recorded by the merchant, because Shopify does not know about money that
/// arrived by bank transfer. Rows are never edited — a correction is another
/// row — so the ledger can always be explained line by line.
/// Why an AI call ended.
enum AiRunStatus {
  OK
  /// Twenty seconds passed. The merchant got the manual path.
  TIMEOUT
  /// Anthropic said no, or asked us to slow down.
  RATE_LIMITED
  /// The model declined the request.
  REFUSED
  /// It answered, but not in a shape we could use — twice.
  INVALID_OUTPUT
  /// Anything else: a network fault, a bad request, an outage.
  ERROR
  /// No API key is configured. Recorded so the reason a feature is quiet is
  /// visible rather than a mystery.
  NO_KEY
}

/// One line of a mirrored order.
///
/// Mirrored because four of the analytics charts cannot be answered without it
/// — top products, rule performance, and anything per-SKU — and Shopify will
/// not answer "which of my rules earned the most last quarter" in one call, at
/// any price.
///
/// Shopify's numbers, in minor units of the order's currency. Nothing here is
/// computed by this app: these are what the buyer was actually charged, which
/// is the only thing an analytics page may report.
model OrderLine {
  id      String @id @default(cuid())
  shop    String
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Shopify's line item GID.
  lineItemId String

  /// Denormalised, because a product deleted in Shopify still sold last March
  /// and a chart that forgets it is a chart that under-reports the past.
  title        String
  variantTitle String?
  sku          String?
  productId    String?
  variantId    String?

  /// As ordered. Shopify's `quantity` is *before* returns and removals, so
  /// this is what was bought, not what the merchant kept.
  quantity        Int @default(0)
  /// After returns and order edits — Shopify's `currentQuantity`. This is the
  /// one revenue is attributed on; `quantity` alone reported a refunded line
  /// as money the merchant still had.
  currentQuantity Int @default(0)

  /// Per unit, before any discount.
  unitPrice       Int @default(0)
  /// The line before discounts, and after them, both as ordered. The
  /// difference between them is what a pricing rule earned or gave away.
  originalTotal   Int @default(0)
  discountedTotal Int @default(0)

  /// What is left of `discountedTotal` after returns and removals.
  ///
  /// Shopify exposes no post-refund line total, so this is apportioned:
  /// `discountedTotal × currentQuantity / quantity`, rounded. Computed once at
  /// write time rather than in every chart, so there is one place it can be
  /// wrong and one place to test. **This is the figure the charts read.**
  currentTotal Int @default(0)

  /// What each discount took off this line: `[{ title, amount }]`.
  ///
  /// Our own rules arrive here under the name the buyer saw at checkout — the
  /// Function sets the winning rule's name as the discount message. That is
  /// how rule performance is measurable at all, and it is also why a renamed
  /// rule does not rewrite its own history.
  discounts Json

  createdAt DateTime @default(now())

  @@unique([shop, lineItemId])
  @@index([shop, orderId])
  @@index([shop, productId])
}

/// One call to Claude.
///
/// Operational, not evidential: the audit log records what a merchant decided,
/// this records what the app asked and what it cost. **No prompt and no
/// completion are stored** — those carry a merchant's product data and their
/// buyers' names, and this table is not the place for either. Token counts and
/// a feature name are enough to answer "what has this been doing" and "what is
/// it costing me".
model AiRun {
  id      String @id @default(cuid())
  shop    String
  /// One of `AI_FEATURES`. Grouped by in the log and counted by the limiter.
  feature String

  status        AiRunStatus @default(OK)
  model         String
  /// The prompt version that produced it, so an old answer stays explicable.
  promptVersion String

  /// Anthropic's own request id, for a support conversation about one call.
  requestId String?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  /// Cached reads are billed differently; kept apart so a cost figure is real.
  cachedTokens Int @default(0)

  latencyMs Int @default(0)
  /// How many times it was tried. Two means the first attempt failed.
  attempts  Int @default(1)

  /// The failure, in the provider's words. Never the prompt, never the answer.
  error String?

  /// Who it was for. Null for scheduled work with nobody watching.
  actorId String?

  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, feature, createdAt])
  @@index([shop, status, createdAt])
}

enum QuoteStatus {
  /// A request has arrived and nobody has priced it yet.
  NEW
  /// Priced. Prices are locked from this moment.
  DRAFTED
  /// With the buyer, waiting on them or on the clock.
  SENT
  /// The buyer took it. A Shopify draft order exists.
  ACCEPTED
  /// The buyer said no, or the merchant withdrew it.
  DECLINED
  /// The date passed without an answer.
  EXPIRED
}

enum QuoteSource {
  /// The merchant built it in the admin.
  MERCHANT
  /// A buyer asked from the storefront (phase 3.4).
  STOREFRONT
  /// The Buyer Agent turned a conversation into a request (phase 5).
  BUYER_AGENT
}

/// A price offered to one buyer, for a set time, at prices that do not move.
///
/// The point of a quote is that the number survives: a buyer quoted a price on
/// Monday who accepts on Thursday pays Monday's price, whatever the merchant
/// changed in between. That is why `QuoteLine` stores what the pricing engine
/// said rather than what it would say now.
model Quote {
  id       String @id @default(cuid())
  shop     String
  /// The unguessable token in the buyer's accept link. Globally unique, so the
  /// public page can find it without knowing the shop.
  publicId String @unique
  /// What the merchant says out loud: "Q-1001".
  number   String

  customerId String?
  email      String?
  company    String?

  status QuoteStatus @default(NEW)
  source QuoteSource @default(MERCHANT)

  currencyCode String @default("USD")
  /// The locked total, in minor units. Recomputed from the lines on every
  /// draft, never edited on its own.
  subtotal     Int    @default(0)

  /// What the buyer asked for, in their words.
  requestNote  String?
  /// What the merchant wants the buyer to read with the quote.
  message      String?
  /// Staff-only.
  internalNote String?

  /// Null means it stands until somebody acts. Set when it is sent.
  expiresAt    DateTime?
  /// Days of validity, copied from settings when it was sent, so changing the
  /// setting does not move a date the buyer has already been told.
  expiryDays   Int?
  /// The warning window, copied at send for the same reason `expiryDays` is.
  /// Read live from `Shop`, raising the setting from 3 to 10 made every
  /// outstanding quote inside ten days of expiry immediately due — a burst of
  /// "your quote is expiring" mail to buyers, which is the exact thing the
  /// Settings copy promises will not happen.
  reminderDays Int?

  /// When the prices on the lines were fixed.
  lockedAt   DateTime?
  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?
  /// The "3 days left" warning goes out once.
  remindedAt DateTime?

  /// Shopify's draft order, created on accept.
  draftOrderId   String?
  draftOrderName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  lines QuoteLine[]

  @@index([shop, status, createdAt])
  @@index([shop, expiresAt])
  @@index([shop, customerId])
}

/// One line of a quote, at the price it was quoted.
model QuoteLine {
  id      String @id @default(cuid())
  shop    String
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  variantId String
  productId String?
  title     String
  sku       String?

  quantity Int @default(1)

  /// What the engine said, in minor units, at `Quote.lockedAt`. This is the
  /// number the buyer is charged, whatever the rules say later.
  unitPrice Int
  /// What it would have cost with no Mannon rule, for the "was" figure.
  listPrice Int

  /// Which rules produced the price. Deciding shows its working, and a merchant
  /// asked "why is this quote cheaper than the site?" needs an answer.
  appliedRuleIds String[]
  /// Already-composed summary, e.g. "Gold tier · 100+ units".
  ruleSummary    String?

  position Int @default(0)

  @@index([shop, quoteId])
}

model Payment {
  id      String @id @default(cuid())
  shop    String
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Minor units of the order's currency. Negative records a correction.
  amount       Int
  currencyCode String   @default("USD")
  receivedAt   DateTime
  /// Free text: "bank transfer, ref 88213".
  reference    String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([shop, orderId])
  @@index([shop, receivedAt])
}

model OrderLimit {
  id      String         @id @default(cuid())
  shop    String
  /// Null means "every wholesale buyer without a more specific limit".
  groupId String?
  group   CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  /// Minor units of the shop's currency. Null means no limit.
  minSubtotal Int?
  maxSubtotal Int?

  minQuantity       Int?
  maxQuantity       Int?
  /// Case packs: the cart's total quantity must be a multiple of this.
  quantityIncrement Int?

  /// ISO 3166-1 alpha-2 codes this limit applies in. Empty means everywhere.
  /// Countries rather than markets — see DECISIONS.md, 2026-09-10.
  countries String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([shop, groupId])
  @@index([shop, enabled])
}

/// A saved customer filter — "spend over $5k, no order in 45 days".
///
/// Stored as conditions, not as a list of people: the point of a segment is
/// that it stays true as the customers change. Turning one into a pricing
/// rule's audience takes a snapshot, and the rule says when it was taken —
/// see DECISIONS.md, 2026-09-10.
model CustomerSegment {
  id   String @id @default(cuid())
  shop String

  name       String
  /// `SegmentCondition[]` from app/lib/customers/segments.ts. Every condition
  /// is checked before it is stored, and again before it is run.
  conditions Json

  /// What Claude was asked, when a sentence made this. Kept with the segment
  /// it made, the way a drafted rule keeps its sentence.
  sentence        String?
  aiModel         String?
  aiPromptVersion String?

  /// The last count, and when. Shown as "as of", never as live truth.
  lastCount   Int?
  lastCountAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([shop, name])
  @@index([shop, updatedAt])
}

/// One morning's briefing from the Merchant Agent.
///
/// Kept rather than regenerated on view, for three reasons: the checklist's
/// "AI down → yesterday's is here" needs a yesterday to show; a briefing that
/// changed every time the page was refreshed would not be something a merchant
/// could act on; and generating one costs a model call the shop pays for.
///
/// The items hold **kinds and reasons**, never figures. Every number on the
/// screen is recomputed from the database when the page renders, so a stale
/// briefing shows a stale timestamp and fresh numbers rather than the other
/// way round — see docs/adr/0021.
model MerchantBriefing {
  id   String @id @default(cuid())
  shop String

  /// `BriefingItem[]` from app/lib/ai/prompts/briefing.server.ts.
  items Json
  /// True when the facts were there but nothing deserved the merchant — the
  /// designed "All quiet" state, which is different from never having run.
  quiet Boolean @default(false)

  generatedAt     DateTime @default(now())
  aiModel         String?
  aiPromptVersion String?
  aiRequestId     String?

  @@index([shop, generatedAt])
}

/// The merchant's standing instructions to the Buyer Agent.
///
/// One row per shop, created on first read. Everything here is a *limit* on
/// what the agent may do, never a capability it gains: an agent with all four
/// abilities switched off can still answer questions, because answering is not
/// an ability the merchant grants — it is what a concierge is.
///
/// `customInstructions` is the one free-text field, and it is bounded and
/// linted: it cannot switch an ability back on, because the abilities are
/// checked in our code before a tool runs, not asked of the model.
/// One month's written review of a shop's wholesale numbers.
///
/// Kept forever, unlike the daily briefing, because the checklist says so and
/// because the point of a monthly review is the run of them: a merchant reads
/// March against February. The month it covers is stored as a plain
/// `YYYY-MM` string in the shop's own timezone — the month a merchant means is
/// their month, and a `DateTime` would put a Sydney shop's January into
/// December for anyone reading it back in UTC.
model MonthlyReview {
  id   String @id @default(cuid())
  shop String

  /// `YYYY-MM`, in the shop's timezone at the time it was generated.
  month String

  /// `ReviewSection[]` from app/lib/ai/prompts/monthly-review.server.ts.
  sections Json
  /// The figures the sections were written from, so the "why" expander shows
  /// the data rather than asking the model to remember it.
  facts    Json
  /// What moved since the month before. Null for a shop's first review, which
  /// has nothing to be a diff of.
  diff     Json?

  /// True when the month had nothing in it worth writing about — different
  /// from a month that was never reviewed.
  quiet Boolean @default(false)

  generatedAt     DateTime @default(now())
  aiModel         String?
  aiPromptVersion String?
  aiRequestId     String?

  @@unique([shop, month])
  @@index([shop, generatedAt])
}

model AgentGuardrails {
  shop String @id

  /// Live on the storefront. The theme block is separate: this is the switch
  /// the merchant controls from the admin, and it wins.
  published   Boolean   @default(false)
  publishedAt DateTime?

  /// May assemble a cart for the buyer to review.
  canBuildCart    Boolean @default(true)
  /// May file a quote request for the merchant to price.
  canRequestQuote Boolean @default(true)
  /// May answer "where is my order?" from mirrored orders.
  canReadOrders   Boolean @default(true)
  /// May state the buyer's net terms and what they owe.
  canReadTerms    Boolean @default(true)

  /// Answers a signed-out visitor at all. Off by default: this is a wholesale
  /// concierge, and retail answers from it are a support ticket waiting.
  guestMode Boolean @default(false)

  /// "warm" | "plain" | "brief". Presets, so tone is not a prompt the merchant
  /// has to write.
  tone String @default("warm")

  /// The merchant's own words, at most `MAX_INSTRUCTION_WORDS`. Advisory to
  /// the model and never load-bearing: see `lintInstructions`.
  customInstructions String?

  /// Subjects the agent declines rather than answers, one per line.
  offLimits String[]

  /// When the merchant last said "I have read these". One of the four things
  /// the pre-publish checklist asks for, and the reason it can ask: a default
  /// nobody looked at is not a guardrail anybody chose.
  reviewedAt DateTime?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// One buyer's conversation with the agent.
///
/// Retained for `CONVERSATION_RETENTION_DAYS` and then deleted with its
/// messages: a wholesale buyer's chat is their business, not ours to keep
/// forever, and the mandatory GDPR topics have to be able to remove it.
model AgentConversation {
  id   String @id @default(cuid())
  shop String

  /// Shopify's customer GID, from the signed proxy request. Null in guest mode.
  customerId String?
  /// What threads a signed-out visitor's turns together, and what their rate
  /// ceiling is counted against. Derived from the request, never sent by it.
  guestKey   String?
  /// Denormalised for the log, so a deleted buyer's conversation still reads.
  company    String?
  /// The language the buyer was answered in.
  locale     String  @default("en")

  /// Starts at FAILED: a conversation is only "answered" once one turn was.
  outcome AgentOutcome @default(FAILED)

  /// A merchant rehearsing against a real buyer's context. Nothing it does
  /// writes: no quote is filed, no escalation is recorded. Flagged on the row
  /// rather than inferred, so the log can never read a rehearsal as a buyer.
  testMode Boolean @default(false)

  /// Set when this thread is finished on purpose — today, a merchant asking
  /// for a fresh rehearsal. A closed conversation is never continued, so the
  /// next message opens a new one, and nothing is deleted or back-dated to
  /// make that happen.
  closedAt DateTime?

  /// Set when a merchant takes the conversation over. The agent stops
  /// answering from this moment and says a person has joined.
  takenOverAt DateTime?
  takenOverBy String?

  startedAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages AgentMessage[]

  @@index([shop, lastMessageAt])
  @@index([shop, customerId])
  @@index([shop, guestKey])
}

/// One turn. The buyer's words, or the agent's, or a merchant who took over.
model AgentMessage {
  id             String            @id @default(cuid())
  shop           String
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role AgentRole
  text String

  /// Which tools ran for this turn and what they returned, for the transcript
  /// and for "why did it say that?". Never shown to the buyer.
  toolCalls Json?

  /// Why a turn was refused, when it was: a guardrail, an off-limits subject,
  /// or a reply that stated a figure we had not computed.
  refusal String?

  aiModel         String?
  aiPromptVersion String?
  aiRequestId     String?

  createdAt DateTime @default(now())

  @@index([shop, conversationId, createdAt])
}

enum AgentOutcome {
  /// Nobody could answer: the model was unreachable, or it wrote something the
  /// guard refused. Kept distinct from ANSWERED so a log full of dead turns
  /// does not read as a log full of helped buyers.
  FAILED
  /// The buyer asked and was answered.
  ANSWERED
  /// A cart was assembled for them to review.
  CART
  /// A quote request was filed for the merchant.
  QUOTE
  /// Handed to a person.
  ESCALATED
  /// A guardrail said no.
  DECLINED
}

enum AgentRole {
  BUYER
  AGENT
  MERCHANT
}

// ---------------------------------------------------------------------------
// Brand voice (phase 6.5)
// ---------------------------------------------------------------------------

/// A message the merchant actually sent, kept so generated copy sounds like
/// them rather than like a model.
///
/// Checklist §8: "paste 2-3 of your emails → Claude matches your tone". Stored
/// as the merchant's own words and shown back to them in full, because a
/// sample they cannot re-read is one they cannot withdraw.
model BrandVoiceSample {
  id    String @id @default(cuid())
  shop  String
  /// What this sample is, in the merchant's words: "how I welcome a new buyer".
  label String
  body  String

  createdAt DateTime @default(now())
  createdBy String?

  @@index([shop, createdAt])
}
